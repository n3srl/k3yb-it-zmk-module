config K3YB_KSCAN_GPIO_DEMUX
    bool "k3yb demux kscan driver with active discharge and settle time"
    default y
    depends on DT_HAS_K3YB_KSCAN_GPIO_DEMUX_ENABLED
    select GPIO

config K3YB_LED_MUX
    bool "k3yb status LEDs via CD4052 mux"
    default y
    depends on DT_HAS_K3YB_LED_MUX_ENABLED
    select GPIO

config K3YB_BEHAVIOR_REPEAT
    bool "k3yb auto-repeat wrapper behavior"
    default y
    depends on DT_HAS_K3YB_BEHAVIOR_REPEAT_ENABLED

config K3YB_BEHAVIOR_LED
    bool "k3yb LED control behavior (backlight / flame toggles)"
    default y
    depends on DT_HAS_K3YB_BEHAVIOR_LED_ENABLED
    depends on K3YB_LED_MUX

config K3YB_BACKLIGHT_MAX
    int "Maximum backlight PWM level (0-255)"
    depends on K3YB_LED_MUX
    range 0 255
    default 64
    help
      Hard cap on the per-key backlight duty, battery-oriented.  The
      brightness step table lives in src/led_mux.c (bl_levels[]); steps
      above this cap are clamped at output time.

config K3YB_LED_BLINK_INDEX
    int "Status indicator used for blink feedback (0-3 = Y0-Y3)"
    depends on K3YB_LED_MUX
    range 0 3
    default 3
    help
      Indicator taken over by the recorder blink (Y3 = the layer LED).
      While a blink is active it overrides that LED's normal state.

config K3YB_LED_BLINK_PERIOD_MS
    int "Slow blink period in ms (50% duty)"
    depends on K3YB_LED_MUX
    range 200 10000
    default 1000
    help
      Blink shown while the recorder is recording.  Sampled by the 40 ms
      LED refresh, so the phase resolution is 40 ms.

config K3YB_RECORDER
    bool "k3yb offline keystroke recorder (internal flash)"
    default y
    depends on $(dt_nodelabel_enabled,recorder_partition)
    depends on K3YB_LED_MUX
    select FLASH
    select FLASH_MAP
    help
      Records key presses to the dedicated recorder_partition (see
      k3yb_it.dtsi) and replays them via HID.  Controlled by the
      &ledctl K3YB_LED_REC_* actions.  The buffer holds typed keys in
      clear text until CLEAR.

if K3YB_RECORDER

config K3YB_RECORDER_PLAYBACK_DELAY_MS
    int "Playback delay between HID steps in ms"
    range 1 1000
    default 12
    help
      Fixed delay after every press, release and modifier change during
      playback (~2 steps per key).  Raise it if the host drops keys.

config K3YB_RECORDER_RESUME
    bool "Resume recording after reset / deep-sleep wake"
    default y
    depends on SETTINGS
    help
      Persists the REC on/off flag (one settings entry, not the buffer),
      so ZMK's idle deep sleep does not end a recording session.

endif # K3YB_RECORDER



config K3YB_STATUS_ICONS
    bool "Status screen uses LVGL symbol icons instead of text markers"
    default n
    help
      Replaces the USB/BT/CH text markers and the battery percentage with
      the built-in LV_SYMBOL_* glyphs, all on the top row (battery on the
      right).  Kept behind an option: glyph rendering crashed the display
      thread before the stack/layout fixes, so text-only stays the default.

config K3YB_SSD1327
    bool "k3yb SSD1327 grayscale OLED driver (mono over I2C)"
    default y
    depends on DT_HAS_K3YB_SSD1327_ENABLED
    depends on DISPLAY
    select I2C

config K3YB_SH1107
    bool "k3yb SH1107 mono OLED driver (I2C)"
    default y
    depends on DT_HAS_K3YB_SH1107_ENABLED
    depends on DISPLAY
    select I2C

if K3YB_SH1107

config K3YB_SH1107_FB_SIZE
    int
    default 2048
    help
      Shadow framebuffer size in bytes (width/8 * height).

endif # K3YB_SH1107

if K3YB_SSD1327

config K3YB_SSD1327_FB_SIZE
    int
    default 8192
    help
      Shadow framebuffer size in bytes (width/2 * height).

config K3YB_SSD1327_TEST_PATTERN
    bool "Draw a calibration test pattern at init"
    default n
    help
      Draws a geometric fingerprint (top edge, left edge, corner blocks)
      at driver init to calibrate the panel remap from a photo.

endif # K3YB_SSD1327
